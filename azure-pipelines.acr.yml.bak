# azure-pipelines.yml
# Full CI/CD pipeline: runs automated tests, builds a Docker image and
# pushes it to Docker Hub, then triggers a live deployment on Render.
#
# Prerequisites:
#   1. Docker Hub account + access token, wired up as the
#      'dockerhub-connection' service connection in this project.
#   2. A Render Web Service connected to this repo, with "Auto-Deploy"
#      turned OFF (so Render only deploys when THIS pipeline tells it to,
#      not on every push by itself).
#   3. A pipeline variable named RENDER_DEPLOY_HOOK_URL (mark it "secret"),
#      set to your Render service's Deploy Hook URL
#      (Render dashboard -> your service -> Settings -> Deploy Hook).

trigger:
  branches:
    include:
      - main

pool:
  vmImage: 'ubuntu-latest'

variables:
  dockerRegistryServiceConnection: 'dockerhub-connection'
  imageRepository: 'corruptgod/dockerised-web-app'
  dockerfilePath: '$(Build.SourcesDirectory)/Dockerfile'
  tag: '$(Build.BuildId)'

stages:
  # ---------------------------------------------------------------------
  # Stage 1: Run automated tests
  # ---------------------------------------------------------------------
  - stage: Test
    displayName: Run automated tests
    jobs:
      - job: RunTests
        displayName: Install dependencies and run tests
        steps:
          - task: NodeTool@0
            inputs:
              versionSpec: '20.x'
            displayName: Install Node.js

          - script: |
              cd app
              npm install
            displayName: Install dependencies

          - script: |
              cd app
              npm test
            displayName: Run tests

  # ---------------------------------------------------------------------
  # Stage 2: Build image and push it to Docker Hub (only if tests passed)
  # ---------------------------------------------------------------------
  - stage: BuildAndPush
    displayName: Build and push image to Docker Hub
    dependsOn: Test
    condition: succeeded()
    jobs:
      - job: Build
        displayName: Build & Push Docker image
        steps:
          - task: Docker@2
            displayName: Build and push image
            inputs:
              containerRegistry: '$(dockerRegistryServiceConnection)'
              repository: '$(imageRepository)'
              command: 'buildAndPush'
              Dockerfile: '$(dockerfilePath)'
              tags: |
                $(tag)
                latest

  # ---------------------------------------------------------------------
  # Stage 3: Deploy to Render (only if build/push succeeded)
  # ---------------------------------------------------------------------
  - stage: Deploy
    displayName: Deploy to Render
    dependsOn: BuildAndPush
    condition: succeeded()
    jobs:
      - job: TriggerRenderDeploy
        displayName: Trigger Render deploy hook
